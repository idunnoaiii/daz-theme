  "tokenColors": [
    {
      "settings": {
        "foreground": "#F8F8F2",
        "background": "#202631"
      }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "regular",
        "foreground": "#5d6874"
      }
    },
    {
      "name": "Constants - Escape, Inheritance",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": {
        "foreground": "#82AAFF",
        // "foreground": "#ffd480",
        "fontStyle": "regular"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#f07076"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": ["keyword", "storage.type"],
      "settings": {
        "foreground": "#d3bdff"
      }
    },
    {
      "name": "Storage - modifier",
      "scope": ["storage.modifier"],
      "settings": {
        "foreground": "#d3bdff"
      }
    },
    {
      "name": "Keyword, Storage - italics",
      "scope": [
        "storage.modifier",
        "meta.var storage.type",
        "keyword.control.from",
        "storage.type.function"
      ],
      "settings": {
        "fontStyle": "regular"
      }
    },
    {
      "name": "Storage - Arrow",
      "scope": ["meta.var storage.type.function.arrow"],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Keyword - operator ($this->stuff), Punctuation - accessor (this.stuff)",
      "scope": ["keyword.operator", "punctuation.accessor.", "operator"],
      "settings": {
        // "foreground": "#d3bdff"
        "foreground": "#89DDFF"
      }
    },

    {
      "name": "Operator, Misc",
      "scope": [
        "constant.other.color",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#F8F8F2"
      }
    },
    {
      "name": "Function, Special Method",
      "scope": [
        "entity.name.function",
        "entity.name.label",
        // "entity.name.type.class",
        "meta.function-call",
        "variable.function",
        "keyword.other.special-method",
        "support.function"
      ],
      "settings": {
        "foreground": "#5ccfe6",
        "fontStyle": ""
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": {
        "foreground": "#5ccfe6",
        "fontStyle": ""
      }
    },
    {
      "name": "Tag jsx",
      "scope": [
        "entity.name.tag.tsx",
        "entity.name.tag.jsx",
        "meta.tag.tsx",
        "meta.embedded.expression.tsx",
        "meta.jsx.children.tsx",
        "meta.tag.tsx",
        "meta.block.tsx",
        "meta.function.expression.tsx",
        "source.tsx"
      ],
      "settings": {
        "foreground": "#F28187",
        "fontStyle": ""
      }
    },
    {
      "name": "Custom Tag",
      "scope": ["entity.name.tag support.class.component"],
      "settings": {
        // "foreground": "#ffd480",
        "foreground": "#5ccfe6",
        "fontStyle": ""
      }
    },
    {
      "name": "Tag Attribute",
      "scope": ["meta.tag.attributes meta.embedded variable.other"],
      "settings": {
        "foreground": "#F8F8F2",
        "fontStyle": ""
      }
    },
    {
      "name": "Variable Type",
      "scope": [
        "meta.type.annotation",
        "meta.type.parameters",
        "entity.name.type",
        "keyword.primitive-datatypes.swift",
        "keyword.type.cs",
        "meta.protocol-list.objc",
        "meta.return-type.objc",
        "source.go storage.type",
        "source.groovy storage.type",
        "source.java storage.type",
        "source.powershell entity.other.attribute-name",
        "storage.class.std.rust",
        "storage.type.attribute.swift",
        "storage.type.c",
        "storage.type.java",
        "storage.type.core.rust",
        "storage.type.cs",
        "storage.type.groovy",
        "storage.type.objc",
        "storage.type.php",
        "storage.type.haskell",
        "storage.type.ocaml",
        "storage.type.annotation"
      ],
      "settings": {
        // "foreground": "#ffd480",
        "foreground": "#82AAFF",
        "fontStyle": ""
      }
    },
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "entity.other.inherited-class",
        "markup.heading",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#bbe77e"
      }
    },
    {
      "name": "Attributes",
      "scope": ["meta.tag.attribute", "entity.other.attribute-name"],
      "settings": {
        "foreground": "#f07076",
        // "foreground": "#ffae57",
        "fontStyle": "regular"
      }
    },
    {
      "name": "Property, Separator, Terminator",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.separator.inheritance",
        "punctuation.section.embedded.begin",
        "punctuation.section.embedded.end"
      ],
      "settings": {
        "foreground": "#f07076"
      }
    },
    {
      "name": "Comma, Semicolon",
      "scope": [
        "punctuation.terminator.statement",
        "punctuation.separator.comma",
        "punctuation.terminator.rule"
      ],
      "settings": {
        "foreground": "#9fa8b2"
      }
    },
    {
      "name": "CSS - Class",
      "scope": [
        "source.css entity.other.attribute-name.class",
        "source.scss entity.other.attribute-name.class",
        "source.styl entity.other.attribute-name.class",
        "source.less entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#ffc670"
      }
    },
    {
      "name": "CSS - ID",
      "scope": [
        "source.css entity.other.attribute-name.id",
        "source.scss entity.other.attribute-name.id",
        "source.styl entity.other.attribute-name.id",
        "source.less entity.other.attribute-name.id"
