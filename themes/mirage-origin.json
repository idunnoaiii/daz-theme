    {
      "name": "CSS - Property Name",
      "scope": [
        "support.type.property-name.css",
        "meta.property-list.scss",
        "meta.property-list.css",
        "meta.property-list.styl",
        "meta.property-list.less"
      ],
      "settings": {
        "foreground": "#F8F8F2",
        "fontStyle": ""
