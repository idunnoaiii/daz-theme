      "settings": {
        "foreground": "#d9dfe7ff"
      }
    },
    {
      "scope": "meta.module-reference",
      "settings": {
        "foreground": "#f07076"
      }
    },
    {
      "scope": "punctuation.definition.list.begin.markd3bdffwn",
      "settings": {
        "foreground": "#ffd395ff"
      }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f07076"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#bbe77e"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
