      }
    },
    {},
    {
      "scope": "fenced_code.block.language",
      "settings": {
        "foreground": "#5ccfe6"
      }
    },
    {
      "scope": "markup.inline.raw.string.markd3bdffwn",
      "settings": {
        "foreground": "#bbe77e"
      }
    },
    {
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ffd395ff"
      }
    },
    {
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5ccfe6"
      }
