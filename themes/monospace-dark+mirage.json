  "semanticHighlighting": true,
  "semanticTokenColors": {
    "property.annotation": "#f07076",
    "annotation": "#f07076",
    "class": "#85cdf1ff",
    "variable.mutable": "#d9dfe7ff",
    "property": "#f07076",
    "interface": "#85cdf1ff",
    "enumMember.defaultLibrary.library": "#f07076",
    "enumMember": "#f07076"
  },
   "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#7f8d9fff"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#d9dfe7ff"
      }
    },
    {
      "scope": ["entity", "entity.name"],
      "settings": {
        "foreground": "#92a9ffff"
      }
    },
    {
      "scope": "variable.parameter.function",
      "settings": {
        "foreground": "#ffd395ff"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#c3e88d"
        // "foreground": "#bbe77e"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#d3bdff"
      }
    },
    {
      "scope": ["storage", "storage.type"],
      "settings": {
        "foreground": "#d3bdff"
      }
    },
    {
      "scope": ["annotation"],
      "settings": {
        "foreground": "#d3bdff"
      }
    },
    {
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java"
      ],
      "settings": {
        "foreground": "#d9dfe7ff"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        "foreground": "#bbe77e"
      }
    },
    {
      "scope": [
        "string.quoted.d3bdffuble.html",
        "string.quoted.single.html",
        "string.unquoted.html",
        "punctuation.definition.string.begin.html",
        "punctuation.definition.string.end.html",
        "string.quoted.d3bdffuble.xml",
        "string.quoted.single.xml",
        "string.unquoted.xml",
        "punctuation.definition.string.begin.xml",
        "punctuation.definition.string.end.xml",
        "string punctuation.section.embedded source"
      ],
      "settings": {
        // "foreground": "#5ccfe6"
      }
    },
    {
      "scope": "support",
      "settings": {
        "foreground": "#f07076"
      }
    },
    {
      "scope": ["support.type.property-name", "entity.name.tag.yaml"],
      "settings": {
        "foreground": "#5ccfe6"
      }
    },
    {
      "scope": "meta.property-name",
      "settings": {
        // "foreground": "#5ccfe6"
        "foreground": "#f07076"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#ffd395ff"
      }
    },
    {
      "scope": "variable.other",
      "settings": {
        "foreground": "#d9dfe7ff"
      }
    },
    {
      "scope": "invalid.broken",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ffc6d0ff"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ffc6d0ff"
      }
    },
    {
      "scope": "invalid.illegal",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ffc6d0ff"
      }
    },
    {
      "scope": "invalid.unimplemented",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ffc6d0ff"
      }
    },
    {
      "scope": "carriage-return",
      "settings": {
        "fontStyle": "italic underline",
        "background": "#d3bdff",
        "foreground": "#1f2939ff",
        "content": "^M"
      }
    },
    {
      "scope": "message.error",
      "settings": {
        "foreground": "#ffc6d0ff"
      }
    },
    {
      "scope": "string source",
      "settings": {
        "foreground": "#d9dfe7ff"
      }
    },
    {
      "scope": "string variable",
      "settings": {
        "foreground": "#5ccfe6"
      }
    },
    {
      "scope": ["source.regexp", "string.regexp"],
      "settings": {
        "foreground": "#bbe77e"
      }
    },
    {
      "scope": [
